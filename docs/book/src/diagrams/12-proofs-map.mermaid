flowchart LR
    classDef mech fill:#d6e6f8,stroke:#1565c0,color:#000
    classDef model fill:#fff3cd,stroke:#b8860b,color:#000
    classDef dmech fill:#d8f0d8,stroke:#2e7d32,color:#000
    classDef retire fill:#eeeeee,stroke:#999999,color:#555,stroke-dasharray: 4 3

    subgraph RM["regolith mechanisms"]
        M1["isolation levels, DefraLevel classes,<br/>projected and value-validated reads, validated scans,<br/>write-free, read-your-own-writes, conflict reasons"]
        M2["commit-ordered append"]
        M3["Db allocate"]
        M4["group commit, lock-free pipeline, ingest slot"]
        M5["WAL format 2 recovery, encryption at rest,<br/>ingest durability, recovery fixes E29 and E30"]
        M6["LSM read order, compact_range, demotion,<br/>ingest placement, tombstone retirement"]
        M7["stripe compaction,<br/>snapshot registry as per-thread slots"]
        M8["per-thread IoQueues: tickets, CacheOnly reads,<br/>claimable single-flight units"]
        M9["regolith sync primitives:<br/>barging with bounded bypass, upgradable read"]
    end

    subgraph RP["regolith proofs: TLA+ and Lean"]
        P1["RepeatableRead.tla: extended"]
        P2["CommitOrderedAppend.tla"]
        P3["Allocate.tla"]
        P4["GroupCommit.tla, CommitPipeline.tla"]
        P5["WalRecovery.tla and .lean, IngestDurability.tla,<br/>recovery models for E29 and E30"]
        P6["LsmOrder.tla and .lean, TombstoneRetirement.tla"]
        P7["StripeCompaction.tla, SnapshotRegistry.tla"]
        P8["NonBlocking.tla: per-thread queues,<br/>IoQueue.lean: exactly once, single-flight"]
        P9["Sync.tla, SyncRwLock.tla, Sync.lean, plus loom"]
    end

    subgraph DM["defradb.rs mechanisms"]
        D1["arrival journal on append"]
        D2["counters as merges"]
        D3["document parts, CRDT order, convergence"]
        D4["head sets"]
        D5["ACP checks, registration, policies"]
        D6["per-core async executors, transaction ownership,<br/>inboxes, document affinity, remote waits"]
        D7["conflict business logic, statement savepoints,<br/>event order, KMS outside transact"]
        D8["indexes, explicit-transaction registry<br/>on owner mailboxes, claims"]
        D9["gents workload on the new primitives"]
    end

    subgraph DP["defradb.rs proofs/tla"]
        Q1["ArrivalJournal.tla"]
        Q2["CounterMerge.tla"]
        Q3["DocumentParts.tla, Convergence family"]
        Q4["HeadSet.tla: updated"]
        Q5["Acp.tla, DeferredAcp.tla: updated"]
        Q6["WorkerPool.tla"]
        Q7["ConflictLogic.tla, StatementAtomicity.tla,<br/>EventOrder.tla, Kms.tla"]
        Q8["IndexReconciliation, TxnRegistry, Claim: updated"]
        Q9["GentsWorkload.tla"]
    end

    subgraph RET["retired with what they model"]
        X1["HeadSetCache.tla"]
        X2["MergeQueue.tla"]
        X3["InteractiveTxnCounter.tla, TwoStoreCounter.tla"]
        X4["Ssi.tla, SsiRange.tla:<br/>the tracker is already deleted"]
    end

    M1 --> P1
    M2 --> P2
    M3 --> P3
    M4 --> P4
    M5 --> P5
    M6 --> P6
    M7 --> P7
    M8 --> P8
    M9 --> P9
    D1 --> Q1
    D2 --> Q2
    D3 --> Q3
    D4 --> Q4
    D5 --> Q5
    D6 --> Q6
    D7 --> Q7
    D8 --> Q8
    D9 --> Q9
    Q1 -.->|"bound to"| P2

    class M1,M2,M3,M4,M5,M6,M7,M8,M9 mech
    class P1,P2,P3,P4,P5,P6,P7,P8,P9,Q1,Q2,Q3,Q4,Q5,Q6,Q7,Q8,Q9 model
    class D1,D2,D3,D4,D5,D6,D7,D8,D9 dmech
    class X1,X2,X3,X4 retire
