flowchart TD
    classDef rego fill:#d6e6f8,stroke:#1565c0,color:#000
    classDef gate fill:#fff3cd,stroke:#b8860b,color:#000
    classDef defra fill:#d8f0d8,stroke:#2e7d32,color:#000
    classDef del fill:#fde7c9,stroke:#c77700,color:#000
    classDef gents fill:#f3e5f5,stroke:#7b1fa2,color:#000

    R2["Phase 2: finish the stack PRs"] --> R3["Phase 3: defect fixes for every user"]
    R2 --> R4["Phase 4: regolith TLA+ models, spec first"]
    R4 --> R5["Phase 5: DefraLevel mechanisms, conflict reasons, regolith sync"]
    R5 --> R6["Phase 6: WAL format 2, ingest, group commit,<br/>per-thread IoQueues, encryption at rest"]
    R6 --> R7["Phase 7: per-core hot paths first,<br/>then the lock-free commit pipeline"]
    R7 --> R8["Phase 8: verification run: gate, TLC, Elle, benches"]
    R8 --> DOD{"definition of done 5.0 holds?<br/>the operator cuts the release and starts Phase 9"}
    DOD -->|"no"| R5
    DOD -->|"yes"| S0["defradb.rs step 0: plain bug fixes, no lock;<br/>dead conflict telemetry and Ssi models deleted"]
    S0 --> S1["step 1: the new regolith, DefraLevel, classifier"]
    S1 --> S2["step 2: every decision inside its transaction"]
    S2 --> S3["step 3: adopt append, allocate, merges, parts, head route"]
    S3 --> S4["step 4: events by commit receipt"]
    S4 --> ST["step 5 first: data-path traits become synchronous"]
    ST --> S5["step 5: transact and per-reason business logic"]
    S5 --> S6["step 6: delete locks one at a time, measured"]
    S6 --> S7["step 7: telemetry from regolith tickers and on_conflict"]
    S7 --> S8["step 8: proofs updated, retired, bound"]
    S8 --> S9["step 9: thread-per-core, one async executor per core,<br/>document affinity, one network runtime,<br/>lens runtime, remote inputs made fast"]
    S9 --> G["gents bumps defradb.rs, applies its changes"]
    S9 --> DEL2["deleted with the pool: SharedTxn RwLock, shared DbTxn mutex,<br/>action_lock, Sync-only mutexes, cache locks, block_on bridges,<br/>four tokio runtimes, tokio and task stealing on the data path"]

    S6 --> DEL["deleted from defradb.rs: head cache, DocWriteQueue, batch_gate,<br/>arrival guard, collection RwLock, per-peer RwLock, ACP mutex,<br/>eleven retry loops, counter finalize, arrival RMW, forced block read,<br/>has_for_update"]

    GATE["every step: baseline at 1, 4, 16, 64 writers,<br/>conflict rate never rises, throughput never drops,<br/>integration and counter conformance tests green"]
    S1 -.-> GATE
    S3 -.-> GATE
    S6 -.-> GATE

    class R2,R3,R4,R5,R6,R7,R8 rego
    class DOD,GATE gate
    class S0,S1,S2,S3,S4,S5,S6,S7,S8,ST,S9 defra
    class DEL,DEL2 del
    class G gents
